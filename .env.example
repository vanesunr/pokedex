# Copy this file to .env to change a value: cp .env.example .env
# Docker Compose and the Makefile both read .env. Every value is optional;
# the defaults below are used when a variable is missing.

# Ports on your machine (the ports inside the containers do not change)
DB_PORT=5432
API_PORT=8080

# Database credentials
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex
POSTGRES_DB=pokedex
